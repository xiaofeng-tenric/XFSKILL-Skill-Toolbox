FILE_TYPE=FORM_DEFN VERSION=2
FORM
FIXED
PORT 46 18
HEADER "XFSKILL - Set Grid by Two Pins"
TILE

TEXT "间距 = 引脚距离 / 等分比"
TLOC 1 1
ENDTEXT

GROUP "参数"
GLOC 1 3
GSIZE 43 12
ENDGROUP

FIELD chk_syncxy
FLOC 2 4
CHECKLIST "X/Y 同步"
ENDFIELD

FIELD chk_origin
FLOC 18 4
CHECKLIST "偏移量 = pin1"
ENDFIELD

FIELD chk_all
FLOC 2 6
CHECKLIST "应用到所有格点"
ENDFIELD

TEXT "等分比"
TLOC 2 9
ENDTEXT

FIELD ratio_2
FLOC 10 9
CHECKLIST "2"
ENDFIELD

FIELD ratio_3
FLOC 15 9
CHECKLIST "3"
ENDFIELD

FIELD ratio_4
FLOC 20 9
CHECKLIST "4"
ENDFIELD

TEXT "引脚1"
TLOC 2 11
ENDTEXT

TEXT
TLOC 8 11
INFO pin1 30
ENDTEXT

TEXT "引脚2"
TLOC 2 13
ENDTEXT

TEXT
TLOC 8 13
INFO pin2 30
ENDTEXT

FIELD btn_ok
FLOC 2 16
MENUBUTTON "OK" 9 3
ENDFIELD

FIELD btn_apply
FLOC 15 16
MENUBUTTON "Apply" 10 3
ENDFIELD

FIELD btn_cancel
FLOC 28 16
MENUBUTTON "Cancel" 10 3
ENDFIELD

ENDTILE
ENDFORM